<Window x:Class="Minesweeper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Minesweeper.Controls"
        Title="扫雷"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        Background="#C0C0C0"
        FontFamily="Tahoma"
        PreviewKeyDown="OnWindowKeyDown"
        PreviewMouseLeftButtonUp="OnAnyLeftButtonUp">
    <Window.Resources>

        <!-- 未翻开格子：Win95 凸起斜面（上左高光、下右阴影） -->
        <Style x:Key="CellButtonStyle" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Background" Value="#C0C0C0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="OuterBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#FFFFFF" BorderThickness="1,1,0,0">
                            <Border BorderBrush="#808080" BorderThickness="0,0,1,1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 已翻开格子：扁平凹陷 -->
        <Style x:Key="CellButtonRevealedStyle" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Background" Value="#C0C0C0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="#808080" BorderThickness="1">
                            <Border BorderBrush="#FFFFFF" BorderThickness="0,0,1,1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 笑脸按钮：凸起，按下变凹陷 -->
        <Style x:Key="SmileyButtonStyle" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="#C0C0C0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="OuterBorder" Background="{TemplateBinding Background}"
                                BorderBrush="#FFFFFF" BorderThickness="1,1,0,0">
                            <Border x:Name="InnerBorder" BorderBrush="#808080" BorderThickness="0,0,1,1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#808080"/>
                                <Setter TargetName="OuterBorder" Property="BorderThickness" Value="0,0,1,1"/>
                                <Setter TargetName="InnerBorder" Property="BorderBrush" Value="#FFFFFF"/>
                                <Setter TargetName="InnerBorder" Property="BorderThickness" Value="1,1,0,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="游戏(_G)">
                <MenuItem Header="新局(_N)" InputGestureText="F2" Click="OnNewGameClick"/>
                <Separator/>
                <MenuItem x:Name="MenuBeginner" Header="初级(_B)" Click="OnDifficultyClick" Tag="Beginner"/>
                <MenuItem x:Name="MenuIntermediate" Header="中级(_I)" Click="OnDifficultyClick" Tag="Intermediate"/>
                <MenuItem x:Name="MenuExpert" Header="高级(_E)" Click="OnDifficultyClick" Tag="Expert"/>
                <Separator/>
                <MenuItem Header="退出(_X)" Click="OnExitClick"/>
            </MenuItem>
        </Menu>

        <!-- 外层凸起大边框（游戏面板） -->
        <Border BorderBrush="#FFFFFF" BorderThickness="1,1,0,0" Margin="4">
            <Border BorderBrush="#808080" BorderThickness="0,0,1,1">
                <Border BorderBrush="#808080" BorderThickness="1,1,0,0">
                    <Border BorderBrush="#FFFFFF" BorderThickness="0,0,1,1" Margin="5">
                        <StackPanel>

                            <!-- 状态面板：凹陷 -->
                            <Border BorderBrush="#808080" BorderThickness="1,1,0,0">
                                <Border BorderBrush="#FFFFFF" BorderThickness="0,0,1,1">
                                    <Border BorderBrush="#808080" BorderThickness="1,1,0,0">
                                        <Border BorderBrush="#FFFFFF" BorderThickness="0,0,1,1" Margin="2">
                                            <Grid>
                                                <controls:LedDisplay x:Name="MineCounter"
                                                                     HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                <Button x:Name="SmileyButton"
                                                        Style="{StaticResource SmileyButtonStyle}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Click="OnSmileyClick"/>
                                                <controls:LedDisplay x:Name="TimerDisplay"
                                                                     HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </Border>
                                </Border>
                            </Border>

                            <!-- 雷区：凹陷 -->
                            <Border BorderBrush="#808080" BorderThickness="1,1,0,0" Margin="0,5,0,0">
                                <Border BorderBrush="#FFFFFF" BorderThickness="0,0,1,1">
                                    <Border BorderBrush="#808080" BorderThickness="1,1,0,0">
                                        <Border BorderBrush="#FFFFFF" BorderThickness="0,0,1,1" Margin="2">
                                            <UniformGrid x:Name="BoardGrid"/>
                                        </Border>
                                    </Border>
                                </Border>
                            </Border>

                        </StackPanel>
                    </Border>
                </Border>
            </Border>
        </Border>
    </DockPanel>
</Window>
