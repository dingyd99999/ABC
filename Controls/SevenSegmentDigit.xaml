<UserControl x:Class="Minesweeper.Controls.SevenSegmentDigit"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Width="22" Height="38" Background="#000000">
        <!-- 七段数码管：A 顶横、B 右上竖、C 右下竖、D 底横、E 左下竖、F 左上竖、G 中横 -->
        <Rectangle x:Name="SegA" Width="12" Height="4" Canvas.ZIndex="1"
                   Fill="#FF0000" RadiusX="1" RadiusY="1"
                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0" />
        <Rectangle x:Name="SegF" Width="4" Height="12"
                   Fill="#FF0000" RadiusX="1" RadiusY="1"
                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2,5,0,0" />
        <Rectangle x:Name="SegB" Width="4" Height="12"
                   Fill="#FF0000" RadiusX="1" RadiusY="1"
                   HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,2,0" />
        <Rectangle x:Name="SegG" Width="12" Height="4"
                   Fill="#FF0000" RadiusX="1" RadiusY="1"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,0" />
        <Rectangle x:Name="SegE" Width="4" Height="12"
                   Fill="#FF0000" RadiusX="1" RadiusY="1"
                   HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="2,0,0,5" />
        <Rectangle x:Name="SegC" Width="4" Height="12"
                   Fill="#FF0000" RadiusX="1" RadiusY="1"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,5" />
        <Rectangle x:Name="SegD" Width="12" Height="4"
                   Fill="#FF0000" RadiusX="1" RadiusY="1"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2" />
    </Grid>
</UserControl>
